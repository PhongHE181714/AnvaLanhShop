@page "{id:int}"
@model GreenShop.Pages.Tags.EditModel
@{
    ViewData["Title"] = "Edit Tag";
    Layout = "~/Pages/Shared/AdminLayout.cshtml";
}

<main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0 d-flex align-items-center">
                        <h6 class="mb-0">Edit Tag</h6>
                        <a asp-page="./Index" class="btn btn-link ms-auto">Back to List</a>
                    </div>
                    <div class="card-body px-4 pt-4">
                        <form method="post">
                            <input type="hidden" asp-for="Tag.Id" />

                            <div class="form-group mb-3">
                                <label asp-for="Tag.Name" class="form-label fw-bold"></label>
                                <input asp-for="Tag.Name" class="form-control" placeholder="Enter tag name" />
                                <span asp-validation-for="Tag.Name" class="text-danger"></span>
                            </div>

                            <div class="form-group mb-3">
                                <label asp-for="Tag.Description" class="form-label fw-bold"></label>
                                <textarea asp-for="Tag.Description" class="form-control"></textarea>
                            </div>

                            <div class="form-check mb-3">
                                <input asp-for="Tag.Status" class="form-check-input" />
                                <label asp-for="Tag.Status" class="form-check-label">Active</label>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary">Save</button>
                                <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
