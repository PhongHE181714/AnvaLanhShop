@page
@model GreenShop.Pages.Tags.CreateModel

<h2>Create Tag</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Tag.Name"></label>
        <input asp-for="Tag.Name" class="form-control" />
        <span asp-validation-for="Tag.Name" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Tag.Description"></label>
        <textarea asp-for="Tag.Description" class="form-control"></textarea>
    </div>

    <div class="form-group mt-2">
        <label>
            <input asp-for="Tag.Status" />
            Active
        </label>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create</button>
    <a asp-page="Index" class="btn btn-secondary mt-3">Back</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
