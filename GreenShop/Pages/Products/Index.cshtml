@page
@model GreenShop.Pages.Products.IndexModel

@{
    ViewData["Title"] = "Product Management";
    Layout = "~/Pages/Shared/AdminLayout.cshtml";
    var searchString = Model.searchString as string;
}

<head>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
</head>

<main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg ">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h6>Product Table</h6>
                        <a href="/Products/Create" class="btn btn-primary">Create</a>
                    </div>

                    <div class="card-body px-0 pt-0 pb-2">
                        <!-- Search Form -->
                        <form method="get" class="mb-3">
                            <div class="row">
                                <div class="col-md-3">
                                    <input type="text" name="searchString" value="@searchString"
                                           placeholder="Search by Product Name"
                                           class="form-control" />
                                </div>
                                <div class="col-md-2">
                                    <button type="submit" class="btn btn-primary">Search</button>
                                </div>
                            </div>
                        </form>

                        <!-- Product Table -->
                        <div class="table-responsive p-0">
                            <table class="table align-items-center mb-0">
                                <thead>
                                    <tr>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Id)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Name)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Price)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Quantity)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Image)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Rate)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Description)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].CategoryId)</th>
                                        <th>@Html.DisplayNameFor(model => model.Product[0].Status)</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Product)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.Name</td>
                                            <td>@item.Price</td>
                                            <td>@item.Quantity</td>
                                            <td>
                                                <img src="@item.Image" alt="Product Image" width="100" />
                                            </td>
                                            <td>@item.Rate</td>
                                            <td>
                                                @(item.Description?.Length > 40
                                                                                            ? item.Description.Substring(0, 40) + "..."
                                                                                            : item.Description)
                                        </td>
                                        <td>@item.CategoryId</td>
                                        <td>@item.Status</td>
                                        <td>
                                            <a href="/Products/Edit?id=@item.Id" class="edit" data-toggle="tooltip" title="Edit">
                                                <i class="material-icons">&#xE254;</i>
                                            </a>
                                            <a href="/Products/Delete?id=@item.Id" onclick="return confirmDelete()" class="delete" data-toggle="tooltip" title="Delete">
                                                <i class="material-icons">&#xE872;</i>
                                            </a>
                                        </td>
                                    </tr>
                                                                        }
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="clearfix d-flex justify-content-between align-items-center mt-3 px-3">
                            <div>
                                <small>
                                    Showing <b>@((Model.page - 1) * Model.pageSize + 1)</b>
                                    -
                                    <b>@Math.Min(Model.page * Model.pageSize, Model.totalProducts)</b>
                                    of <b>@Model.totalProducts</b> products
                                </small>
                            </div>

                            <ul class="pagination mb-0">
                                @{
                                    var page = Model.page;
                                    var max = Model.pageLength;
                                    var next = page + 1;
                                    var pre = page - 1;
                                }

                                @if (page > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@pre&searchString=@Model.searchString">Previous</a>
                                    </li>
                                }

                                @for (int i = 1; i <= max; i++)
                                {
                                    if (page == i)
                                    {
                                        <li class="page-item active">
                                            <a class="page-link" href="?page=@i&searchString=@Model.searchString">@i</a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="page-item">
                                            <a class="page-link" href="?page=@i&searchString=@Model.searchString">@i</a>
                                        </li>
                                    }
                                }

                                @if (page < max)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="?page=@next&searchString=@Model.searchString">Next</a>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/3.1.18/signalr.min.js"></script>

<script type="text/javascript">
    function confirmDelete() {
        return confirm('Are you sure you want to delete this product?');
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/productHub")
        .build();

    connection.on("ReceiveProductUpdate", function (productId, action) {
        alert("Product " + action + ": " + productId);
        location.reload();
    });

    connection.start().catch(err => console.error(err.toString()));
</script>
