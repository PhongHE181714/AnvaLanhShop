@page
@model GreenShop.Pages.Products.DeleteModel

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Pages/Shared/AdminLayout.cshtml";
}

<h1>Delete Product</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Product</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Name)</dd>
        <dt class="col-sm-2">Price</dt>
        <dd class="col-sm-10">@(Model.Product.ProductSizes.Any() ? Model.Product.ProductSizes.Min(s => s.Price).ToString("N0") : "—")</dd>
        <dt class="col-sm-2">Quantity</dt>
        <dd class="col-sm-10">@(Model.Product.ProductSizes.Sum(s => s.Quantity))</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.CategoryId)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.CategoryId)</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Product.Status)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Product.Status)</dd>
    </dl>

    <form id="deleteForm" method="post">
        <input type="hidden" asp-for="Product.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>

@section Scripts {
    <script>
        document.getElementById("deleteForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);

            const response = await fetch(window.location.pathname, {
                method: "POST",
                body: formData,
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (response.ok) {
                alert(" Product deleted (soft delete) successfully!");
                window.location.href = "/Products";
            } else if (response.status === 400 || response.status === 409) {
                const result = await response.json().catch(() => ({}));
                alert(result.message || "Cannot delete this product.");
            } else {
                const text = await response.text();
                console.error("❌ Delete failed:", text);
                alert("Error: Failed to delete product");
            }
        });
    </script>
}
