@page
@model GreenShop.Pages.Login.ResetPasswordModel
@{
    Layout = "~/Pages/Shared/LoginLayout.cshtml";
}

<body>
    <main class="main-content  mt-0">
        <section>
            <div class="page-header min-vh-75">
                <div class="container">
                    <div class="row">
                        <div class="col-xl-4 col-lg-5 col-md-6 d-flex flex-column mx-auto">
                            <div class="card card-plain mt-8">
                                <div class="card-header pb-0 text-left bg-transparent">
                                    <h3 class="font-weight-bolder text-success text-gradient">
                                        <i class="fa fa-eye me-2"></i>Reset Password
                                    </h3>
                                    <p class="mb-0">Enter your new password</p>
                                </div>
                                <div class="card-body">
                                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                    {
                                        <div class="alert alert-danger" role="alert">
                                            @Model.ErrorMessage
                                        </div>
                                    }

                                    @if (Model.IsTokenValid)
                                    {
                                        <form method="post">
                                            <input type="hidden" asp-for="Token" />

                                            <label>New Password</label>
                                            <div class="mb-3 position-relative">
                                                <input type="password" asp-for="NewPassword" id="newPassword" required class="form-control" placeholder="Enter new password" minlength="8">
                                                <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-n1 me-2 shadow-none" onclick="togglePassword('newPassword', this)" style="z-index: 10;">
                                                    <i class="fa fa-eye"></i>
                                                </button>
                                            </div>

                                            <label>Confirm Password</label>
                                            <div class="mb-3 position-relative">
                                                <input type="password" asp-for="ConfirmPassword" id="confirmPassword" required class="form-control" placeholder="Confirm new password" minlength="8">
                                                <button type="button" class="btn btn-link position-absolute end-0 top-0 mt-n1 me-2 shadow-none" onclick="togglePassword('confirmPassword', this)" style="z-index: 10;">
                                                    <i class="fa fa-eye"></i>
                                                </button>
                                            </div>

                                            <div class="text-center">
                                                <button type="submit" class="btn bg-gradient-success w-100 mt-4 mb-0">Update Password</button>
                                            </div>
                                        </form>
                                    }
                                    else
                                    {
                                        <div class="text-center">
                                            <a href="/Login/ForgetPassword" class="btn bg-gradient-success w-100 mt-4 mb-0">Request New Reset Link</a>
                                        </div>
                                    }
                                </div>

                                <div class="card-footer text-center pt-0 px-lg-2 px-1">
                                    <p class="mb-4 text-sm mx-auto">
                                        Remember your password?
                                        <a href="/Login" class="text-success text-gradient font-weight-bold">Sign In</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="oblique position-absolute top-0 h-100 d-md-block d-none me-n8">
                                <div class="oblique-image bg-cover position-absolute fixed-top ms-auto h-100 z-index-0 ms-n6" style="background-image:url('/img/green-and-white-marbled-coloring.jpg')"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</body>
