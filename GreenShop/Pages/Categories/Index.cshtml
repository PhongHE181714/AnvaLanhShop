@page
@model GreenShop.Pages.Categories.IndexModel
@{
    ViewData["Title"] = "Category Management";
    Layout = "~/Pages/Shared/AdminLayout.cshtml";
}

<head>
    <link rel="stylesheet" href="https://fonts.googleapis.com/icon?family=Material+Icons">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <style>
        .table-fixed {
            table-layout: fixed;
            width: 100%;
        }

            .table-fixed th, .table-fixed td {
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

        .action-btn {
            font-size: 1.3rem;
            margin: 0 6px;
            color: #6c757d;
            transition: color 0.2s;
        }

            .action-btn:hover {
                color: #0d6efd;
            }

        .status-badge {
            font-size: 0.85rem;
            padding: 0.35em 0.65em;
        }

        #colStatus {
            transition: all .3s ease;
        }
    </style>
</head>

<main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <!-- Header -->
                    <div class="card-header pb-0 d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Category Management</h6>
                        <div>
                            <button id="toggleStatus" class="btn btn-outline-secondary btn-sm me-2">
                                <i class="material-icons">visibility</i> Status
                            </button>
                            <a asp-page="Create" class="btn btn-success btn-sm">
                                <i class="material-icons">add</i> Create New
                            </a>
                        </div>
                    </div>

                    <div class="card-body px-4 pt-3 pb-2">
                        <!-- Table -->
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-fixed mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th width="15%">Category ID</th>
                                        <th width="45%">Name</th>
                                        <th width="15%" id="colStatus">Status</th>
                                        <th width="25%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Category)
                                    {
                                        <tr>
                                            <td><strong>#@item.Id</strong></td>
                                            <td title="@item.Name">@item.Name</td>
                                            <td id="colStatus">
                                                <span class="badge status-badge @(item.Status == 1 ? "bg-success" : "bg-secondary")">
                                                    @(item.Status == 1 ? "Active" : "Inactive")
                                                </span>
                                            </td>
                                            <td>
                                                <a href="@Url.Page("Edit", new { id = item.Id })"
                                                   class="action-btn" title="Edit">
                                                    <i class="material-icons">edit</i>
                                                </a>
                                                <a href="@Url.Page("Delete", new { id = item.Id })"
                                                   onclick="return confirm('Delete category \" @item.Name\"?')"
                                                   class="action-btn text-danger" title="Delete">
                                                    <i class="material-icons">delete</i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Hiển thị tổng số -->
                        <div class="mt-3">
                            <small class="text-muted">
                                Total: <strong>@Model.Category.Count()</strong> categories
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- SignalR + Toastr -->
<!-- Toastr -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
    // Toggle Status Column
    document.getElementById('toggleStatus')?.addEventListener('click', function () {
        document.querySelectorAll('#colStatus').forEach(el => {
            el.style.display = el.style.display === 'none' ? '' : 'none';
        });
        const icon = this.querySelector('i');
        icon.textContent = icon.textContent === 'visibility' ? 'visibility_off' : 'visibility';
    });

    toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: "toast-top-right",
        timeOut: 3000
    };
</script>
