@page
@model GreenShop.Pages.Categories.CreateModel

@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Pages/Shared/AdminLayout.cshtml";
}

<main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0">
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0">Create Category</h6>
                            <a asp-page="./Index" class="btn btn-link ms-auto">
                                <i class="material-icons"></i> Back to List
                            </a>
                        </div>
                    </div>
                    <div class="card-body px-4 pt-4">
                        <form id="createForm" method="post">
                            <div class="form-group mb-4">
                                <label asp-for="Category.Name" class="form-label fw-bold"></label>
                                <input asp-for="Category.Name" class="form-control form-control-lg" placeholder="Enter category name" />
                                <span asp-validation-for="Category.Name" class="text-danger"></span>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="material-icons">save</i>
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary btn-lg">
                                    <i class="material-icons">cancel</i>
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script>
        document.getElementById("createForm").addEventListener("submit", async function (e) {
            e.preventDefault();

            const form = this;
            const formData = new FormData(form);

            const response = await fetch(window.location.pathname, {
                method: "POST",
                body: formData,
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            if (response.ok) {
                console.log("✅ Category created successfully");
                window.location.href = "/Categories";
            }
            else if (response.status === 409) {
                // ⚠️ Trùng tên → lấy message từ server
                const result = await response.json();
                alert(result.message || "Category name already exists.");
            }
            else if (response.status === 400) {
                const result = await response.json().catch(() => ({}));
                alert(result.message || "Invalid input.");
            }
            else {
                const text = await response.text();
                console.error("❌ Create failed:", text);
                alert("Error: Failed to create category");
            }
        });
    </script>
}

