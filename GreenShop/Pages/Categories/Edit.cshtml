@page
@model GreenShop.Pages.Categories.EditModel
@{
    ViewData["Title"] = "Edit Category";
    Layout = "~/Pages/Shared/AdminLayout.cshtml";
}

<main class="main-content position-relative max-height-vh-100 h-100 border-radius-lg">
    <div class="container-fluid py-4">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header pb-0">
                        <div class="d-flex align-items-center">
                            <h6 class="mb-0">Edit Category</h6>
                            <a asp-page="./Index" class="btn btn-link ms-auto">
                                <i class="material-icons"></i> Back to List
                            </a>
                        </div>
                    </div>
                    <div class="card-body px-4 pt-4">
                        <form method="post">
                            <input type="hidden" asp-for="Category.Id" />

                            <div class="row">
                                <div class="col-md-8">
                                    <div class="form-group mb-4">
                                        <label asp-for="Category.Name" class="form-label fw-bold"></label>
                                        <input asp-for="Category.Name" class="form-control form-control-lg" placeholder="Enter category name" />
                                        <span asp-validation-for="Category.Name" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-4">
                                        <label asp-for="Category.Status" class="form-label fw-bold">Status</label>
                                        <select asp-for="Category.Status" class="form-select form-select-lg">
                                            <option value="1">Active</option>
                                            <option value="0">Inactive</option>
                                        </select>
                                        <span asp-validation-for="Category.Status" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="material-icons">save</i> 
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary btn-lg">
                                    <i class="material-icons">cancel</i> 
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
    document.querySelector("form").addEventListener("submit", function (e) {
        e.preventDefault(); // ❌ chặn reload form mặc định

        const form = this;
        const formData = new FormData(form);

        fetch(window.location.pathname, {
            method: "POST",
            body: formData
        })
        .then(response => {
            if (response.ok) {
                console.log("✅ Category updated successfully");
                // ✅ Sau khi cập nhật thành công → quay lại trang Index
                window.location.href = "/Categories";
            } else {
                console.error("❌ Failed to update category");
                alert("Error: Failed to update category");
            }
        })
        .catch(err => {
            console.error("⚠️ AJAX error:", err);
            alert("An unexpected error occurred.");
        });
    });
</script>
